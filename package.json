{
  "name": "nightwave-player",
  "version": "1.1.0",
  "private": true,
  "main": "expo-router/entry",
  "expo": {
    "autolinking": {
      "android": {
        "buildFromSource": [
          "expo-audio"
        ]
      }
    }
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "typecheck": "tsc --noEmit",
    "verify:api": "node scripts/verify-api.mjs",
    "build:apk": "eas build --platform android --profile preview",
    "format": "prettier --write app src scripts/*.mjs *.json",
    "test:player": "node scripts/verify-player.mjs",
    "test:lyrics": "node scripts/verify-lyrics.mjs"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/slider": "5.2.1",
    "@react-navigation/bottom-tabs": "^7.16.0",
    "@tanstack/react-query": "^5.90.0",
    "expo": "~58.0.0",
    "expo-audio": "~58.0.12",
    "expo-blur": "~58.0.6",
    "expo-build-properties": "~58.0.12",
    "expo-constants": "~58.0.16",
    "expo-dev-client": "~58.0.20",
    "expo-image": "~58.0.18",
    "expo-linear-gradient": "~58.0.4",
    "expo-router": "~58.0.31",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "lucide-react-native": "^1.73.0",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-worklets": "0.13.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "babel-preset-expo": "~58.0.25",
    "prettier": "^3.10.1",
    "typescript": "~5.9.2"
  }
}
